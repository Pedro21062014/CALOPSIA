{
  "name": "calopsia",
  "productName": "CALOPSIA",
  "version": "0.5.4",
  "description": "CALOPSIA — navegador web moderno baseado em Chromium (Electron). Interface própria com abas, busca integrada, localizar na página, zoom e downloads.",
  "homepage": "https://github.com/Pedro21062014/CALOPSIA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pedro21062014/CALOPSIA.git"
  },
  "bugs": {
    "url": "https://github.com/Pedro21062014/CALOPSIA/issues"
  },
  "author": {
    "name": "CALOPSIA",
    "email": "calopsia@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "node --check main.js && node --check preload.js && node --check preload-menu.js && node --check preload-popup.js && node --check webview-preload.js && node --check src/renderer.js && node --check src/newtab.js && node --check src/about.js && node --check src/updater.js && node --check src/tabs.js && node --check src/menu.js && node --check src/popup.js && node --check src/senhas.js && node --check src/cofre.js",
    "release:linux": "npm run dist:linux -- --publish never",
    "icons": "node scripts/gen-icons.js",
    "predist": "npm run icons",
    "predist:win": "npm run icons",
    "predist:mac": "npm run icons",
    "predist:linux": "npm run icons"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.calopsia.browser",
    "productName": "CALOPSIA",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "buildres"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-menu.js",
      "preload-popup.js",
      "webview-preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/icons/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-1024.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-1024.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icons",
      "executableName": "calopsia",
      "maintainer": "CALOPSIA <calopsia@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portatil.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Pedro21062014",
      "repo": "CALOPSIA"
    },
    "icon": "assets/icon-1024.png"
  }
}