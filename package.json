{
  "name": "calopsia",
  "productName": "CALOPSIA",
  "version": "1.0.1",
  "description": "CALOPSIA — navegador moderno, rápido e elegante baseado em Chromium e Electron",
  "main": "src/main/main.js",
  "author": {
    "name": "Calopsia Browser",
    "email": "hello@calopsia.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --linux --win",
    "lint": "eslint src --ext .js",
    "test": "npm run lint"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0"
  },
  "build": {
    "appId": "app.calopsia.browser",
    "productName": "CALOPSIA",
    "copyright": "Copyright © 2026 CALOPSIA",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network;WebBrowser"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CALOPSIA"
    },
    "dmg": {
      "title": "Instalar CALOPSIA",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "artifactName": "CALOPSIA-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://github.com/Pedro21062014/CALOPSIA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pedro21062014/CALOPSIA.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
