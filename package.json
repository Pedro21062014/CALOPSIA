{
  "name": "calopsia",
  "productName": "CALOPSIA",
  "version": "0.2.0",
  "description": "CALOPSIA — navegador web moderno baseado em Chromium (Electron). Interface própria com abas, busca integrada, localizar na página, zoom e downloads.",
  "author": {
    "name": "CALOPSIA",
    "email": "calopsia@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check src/newtab.js && node --check src/about.js",
    "release:linux": "npm run dist:linux -- --publish never"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.calopsia.browser",
    "productName": "CALOPSIA",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "calopsia",
      "maintainer": "CALOPSIA <calopsia@users.noreply.github.com>",
      "synopsis": "Navegador web moderno baseado em Chromium",
      "desktop": {
        "Name": "CALOPSIA",
        "Comment": "Navegador web moderno baseado em Chromium",
        "StartupWMClass": "calopsia"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-instalador.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libasound2"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portatil.${ext}"
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "Pedro21062014",
      "repo": "CALOPSIA"
    }
  }
}
